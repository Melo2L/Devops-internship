      },
      "pluginVersion": "12.2.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (status) (securescan_scans_total)",
          "legendFormat": "{{status}}",
          "range": false,
          "refId": "A",
          "instant": true
        }
